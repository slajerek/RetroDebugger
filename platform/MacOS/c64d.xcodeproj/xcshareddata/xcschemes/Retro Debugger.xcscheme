            BuildableName = "Retro Debugger.app"
            BlueprintName = "Retro Debugger"
            ReferencedContainer = "container:c64d.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
      <CommandLineArguments>
         <CommandLineArgument
            argument = "/Users/mars/develop/MTEngine/_RUNTIME_/Documents/c64/disks/demos/crest\ -\ BluREU_3D/BluREU\ 3D.prg"
            isEnabled = "NO">
         </CommandLineArgument>
         <CommandLineArgument
