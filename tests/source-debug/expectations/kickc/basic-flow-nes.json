{
  "fixture": "basic-flow",
  "compiler": "kickc",
  "optimization": "debug",
  "machine": "nes",
  "artifacts": "tests/data/source-debug/kickc/nes/basic-flow",
  "binary": "main.nes",
  "debugInfo": "main.dbg",
  "start": {
    "file": "main.c",
    "line": 16
  },
  "steps": [
    {
      "action": "sourceOver",
      "expected": {
        "file": "main.c",
        "line": 17,
        "function": "main",
        "depth": 0
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceInto",
      "expected": {
        "file": "main.c",
        "line": 12,
        "function": "doSomething",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceInto",
      "expected": {
        "file": "main.c",
        "line": 8,
        "function": "add",
        "depth": 2
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOut",
      "expected": {
        "file": "main.c",
        "line": 12,
        "function": "doSomething",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOver",
      "expected": {
        "file": "main.c",
        "line": 13,
        "function": "doSomething",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOver",
      "expected": {
        "file": "main.c",
        "line": 18,
        "function": "main",
        "depth": 0
      },
      "expectedReason": "frame-exited"
    },
    {
      "action": "sourceInto",
      "expected": {
        "file": "main.c",
        "line": 8,
        "function": "add",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceInto",
      "note": "KickC -Sl places line 9 (the closing brace) before add()'s RTS",
      "expected": {
        "file": "main.c",
        "line": 9,
        "function": "add",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOver",
      "expected": {
        "file": "main.c",
        "line": 18,
        "function": "main",
        "depth": 0
      },
      "expectedReason": "frame-exited"
    },
    {
      "action": "sourceOver",
      "budget": 20000,
      "note": "KickC writes no comment for for (;;): its JMP stays under line 18's comment, so Over runs it to the budget",
      "expected": {
        "file": "main.c",
        "line": 18,
        "function": "main",
        "depth": 0
      },
      "expectedReason": "budget-exceeded"
    }
  ],
  "note": "KickC 0.8.6 -Sl: C lines come from KickC's '// file:line' comments in main.asm (Approximate); add() takes its arguments in registers, so no IRQ calls it"
}
