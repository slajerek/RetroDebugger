      "note": "into the inlined work(): no call instruction, the origins name the frame"
    },
    {
      "action": "sourceOver",
      "expected": {
        "file": "main-O2.c",
        "line": 19,
        "function": "work",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceInto",
      "expected": {
        "file": "main-O2.c",
        "line": 14,
        "function": "addOne",
        "depth": 2
      },
      "expectedReason": "completed",
      "note": "a real call from inlined code: one deeper than the inline frame"
    },
    {
      "action": "sourceOut",
      "expected": {
        "file": "main-O2.c",
        "line": 19,
        "function": "work",
        "depth": 1
      },
      "expectedReason": "completed",
      "note": "back after the call, in the inlined work()"
    },
    {
      "action": "sourceOut",
      "expected": {
        "file": "main-O2.c",
        "line": 25,
        "function": "main",
        "depth": 0
      },
      "expectedReason": "completed",
      "note": "out of the inlined work(): main's next line"
    }
  ]
}
