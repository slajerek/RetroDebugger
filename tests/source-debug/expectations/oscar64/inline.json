{
  "fixture": "inline",
  "compiler": "oscar64",
  "optimization": "O2",
  "machine": "c64",
  "artifacts": "tests/data/source-debug/oscar64/c64-O2/inline",
  "binary": "main.prg",
  "debugInfo": "main.dbj",
  "entry": "0x080D",
  "note": "Oscar64 -O2 inlines work() into main: its lines 18 and 19 are a logical frame of their own (RD-017, the .dbj origins)",
  "start": {
    "file": "main-O2.c",
    "line": 23
  },
  "steps": [
    {
      "action": "sourceInto",
      "expected": {
        "file": "main-O2.c",
