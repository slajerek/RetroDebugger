{
  "fixture": "recursion",
  "compiler": "cc65",
  "optimization": "debug",
  "machine": "nes",
  "artifacts": "tests/data/source-debug/cc65/nes/recursion",
  "binary": "main.nes",
  "debugInfo": "main.dbg",
  "start": {
    "file": "main.c",
    "line": 14
  },
  "steps": [
    {
      "action": "sourceInto",
      "expected": {
        "file": "main.c",
        "line": 8,
        "function": "sum",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOver",
      "expected": {
        "file": "main.c",
        "line": 10,
        "function": "sum",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceInto",
      "expected": {
        "file": "main.c",
        "line": 8,
        "function": "sum",
        "depth": 2
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOver",
      "expected": {
        "file": "main.c",
        "line": 10,
        "function": "sum",
        "depth": 2
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOut",
      "note": "out of the second instance: back in the first, on the same line",
      "expected": {
        "file": "main.c",
        "line": 10,
        "function": "sum",
        "depth": 1
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOut",
      "expected": {
        "file": "main.c",
        "line": 14,
        "function": "main",
        "depth": 0
      },
      "expectedReason": "completed"
    },
    {
      "action": "sourceOver",
      "expected": {
        "file": "main.c",
        "line": 15,
        "function": "main",
        "depth": 0
      },
      "expectedReason": "completed"
    }
  ]
}
